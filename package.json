{
  "name": "medi-reminder",
  "version": "3.4.2",
  "description": "Offline-first medication reminder with persistent alerts until dose confirmed — Final release optimized for mobile",
  "private": true,
  "type": "module",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test && npm run build",
    "icons": "python3 scripts/generate_icons.py",
    "icons:prebuild": "python3 scripts/generate_icons.py || true",
    "clean": "rm -rf dist node_modules/.vite",
    "lint:deps": "npm audit --omit=dev"
  },

  "prebuild": "npm run icons:prebuild",

  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@salarizadi/capacitor-cafebazaar-poolakey": "^1.1.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },

  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vitest": "5.0.0"
  },

  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.1.0"
  },

  "os": [
    "linux",
    "darwin",
    "win32"
  ],

  "cpu": [
    "x64",
    "arm64"
  ],

  "sideEffects": false,

  "overrides": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  }
}

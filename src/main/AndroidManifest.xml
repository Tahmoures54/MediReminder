<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ===================== Reliability Permissions (v3.4.1) ===================== -->
    <!-- نمایش اعلان‌ها (اندروید ۱۳+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ویبره برای هشدار قوی -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Exact alarms:
         USE_EXACT_ALARM — auto-granted when core feature is exact timing (Android 13+)
         SCHEDULE_EXACT_ALARM — for Android 12 and as fallback path -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <!-- بازگردانی آلارم‌ها پس از ریبوت -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- جلوگیری از خواب CPU هنگام اجرای آلارم -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- سرویس پیش‌زمینه (در صورت نیاز آینده) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- درخواست معافیت از بهینه‌سازی باتری -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- اعلان تمام‌صفحه هنگام قفل بودن گوشی -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- لینک پشتیبانی واتساپ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
